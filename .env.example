# Copy to .env and fill in. Generate secrets with: npm run gen:secrets -w @scc/backend
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=0
LOG_LEVEL=info

MONGO_URI=mongodb://localhost:27017/scc?replicaSet=rs0
REDIS_URL=redis://localhost:6379

JWT_PRIVATE_KEY=
JWT_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY=
JWT_PREVIOUS_KEY_ID=
CSRF_SECRET=
PASSWORD_PEPPER=
MFA_ENCRYPTION_KEY=

ALLOWED_EMAIL_DOMAINS=iem.edu.in
HIBP_ENABLED=true
TURNSTILE_SECRET_KEY=

SMTP_URL=smtp://localhost:1025
MAIL_FROM="Campus Buddy <no-reply@campus-buddy.local>"

# Added in later phases
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_QUARANTINE=scc-quarantine
S3_BUCKET_FILES=scc-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SENTRY_DSN=
